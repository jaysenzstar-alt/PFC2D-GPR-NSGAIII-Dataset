new
set logfile restore.log
set log on
load fish './fishuser_function005_64.dll'
restore g_1.p2sav
set logfile restore.log
set log on
set precision 15
set processors 24
[replay_ball_count=ball.num]
list @replay_ball_count
list @wlx
list @wly
[emod=71011471506.23381]
[krat=1.78030173460698]
[ten=43121057.6328573]
[coh=19721799.277348801]
[fa=22.159189881916799]
call 3-bonded.p2dat
list @emod
list @krat
list @ten
list @coh
list @fa
[mstrain_xx=0]
[mstrain_yy=0]
[peak_stress=0]
history id 21 @mstrain_yy
history id 22 @mstrain_xx
call 44-ucs.p2dat
set logfile restore.log
set log on
set precision 15
history write 11 12 13 14 21 22 15 file history.his csv
save recovered.p2sav
[scope_done=1]
list @scope_done
set log off
quit
